{
  "expo": {
    "name": "RooMate",
    "slug": "roomate",
    "scheme": "roomate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "locales": {
      "he": "./locales/he.json"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "he"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chay0386.roomate",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "RooMate צריך גישה לתמונות כדי להעלות רילס",
          "cameraPermission": "RooMate צריך מצלמה כדי לצלם רילס",
          "microphonePermission": "RooMate צריך מיקרופון לוידאו"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
